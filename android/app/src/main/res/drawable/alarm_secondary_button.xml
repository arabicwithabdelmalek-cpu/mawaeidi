<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8EFF3" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/alarmPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFB" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/alarmLine" />
        </shape>
    </item>
</selector>
